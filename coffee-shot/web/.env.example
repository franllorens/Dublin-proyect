# Public base URL of this app (must be HTTPS for Apple Wallet updates)
APP_BASE_URL=https://coffeeshot-club.example.com

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Apple Wallet (Apple Developer Program → Identifiers → Pass Type IDs)
APPLE_PASS_TYPE_ID=pass.com.workflowers.coffeeshot
APPLE_TEAM_ID=
# PEM contents, with real newlines or \n escapes
APPLE_WWDR_PEM=
APPLE_SIGNER_CERT_PEM=
APPLE_SIGNER_KEY_PEM=
APPLE_SIGNER_KEY_PASSPHRASE=

# Google Wallet (Google Pay & Wallet Console → issuer; Google Cloud → service account JSON key)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=

# Staff PIN check for the barista app (per-location PINs live in the staff table)
STAFF_SESSION_SECRET=

# Optional: force demo mode even when the variables above are set (1 = demo)
NEXT_PUBLIC_FORCE_DEMO=

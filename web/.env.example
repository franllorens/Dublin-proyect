# Static site (Cloudflare Pages). Set these as build-time environment variables.

# Wallet API (backend/fallow-wallet deployed on Railway). Empty = demo mode, everything simulated in the browser.
NEXT_PUBLIC_API_URL=

# Public URL of this site (used for metadata)
NEXT_PUBLIC_SITE_URL=https://fallow-coffee.pages.dev

# 1 = force demo mode even with NEXT_PUBLIC_API_URL set
NEXT_PUBLIC_FORCE_DEMO=
